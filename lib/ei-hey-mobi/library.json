{
  "name": "ei-hey-mobi",
  "version": "1.0.0",
  "description": "Edge Impulse Hey Mobi wake word model for ESP32-S3",
  "build": {
    "srcFilter": [
      "+<tflite-model/tflite_learn_1155410_3_compiled.cpp>",
      "+<edge-impulse-sdk/porting/espressif/ei_classifier_porting.cpp>",
      "+<edge-impulse-sdk/porting/espressif/debug_log.cpp>",
      "+<edge-impulse-sdk/dsp/memory.cpp>",
      "+<edge-impulse-sdk/dsp/kissfft/kiss_fft.cpp>",
      "+<edge-impulse-sdk/dsp/kissfft/kiss_fftr.cpp>",
      "+<edge-impulse-sdk/dsp/dct/fast-dct-fft.cpp>",
      "+<edge-impulse-sdk/tensorflow/lite/core/api/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/kernels/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/kernels/custom/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/kernels/internal/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/micro/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/micro/kernels/*.cc>",
      "+<edge-impulse-sdk/tensorflow/lite/micro/memory_planner/*.cc>"
    ],
    "flags": [
      "-DEI_PORTING_ESPRESSIF=1",
      "-DEIDSP_QUANTIZE_FILTER_COEFFICIENTS=0",
      "-DEI_CLASSIFIER_TFLITE_ENABLE_ESP_NN=0",
      "-DEI_DSP_IMAGE_PROCESSING=0",
      "-Wno-error=unused-variable",
      "-Wno-error=unused-but-set-variable"
    ],
    "includeDir": "."
  }
}
